<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gaotu.appium-matrix.webhook</string>

  <!-- 固定到 CommandLineTools python3(已装 flask + yaml)：不受 xcode-select 影响。
       勿用 /usr/bin/python3：xcode-select 指向 Xcode.app 时会转发到 Xcode python，
       该解释器经 launchd 启动无 TCC 权限读 ~/Documents，报 Operation not permitted。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Developer/CommandLineTools/usr/bin/python3</string>
    <string>/Users/mac/Documents/projects/appium-mcp-matrix/server/app.py</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>ENABLED_APPS</key>
    <string>gaotu</string>
    <key>ORCH_AGENT_CLI</key>
    <string>codex</string>
    <key>PORT</key>
    <string>10086</string>
    <!-- 完整安装包(大小严格 == 远端 Content-Length)跨轮复用，跳过重复下载；
         残包/对不上远端大小仍会重下，不会误用截断包。 -->
    <key>ORCH_SKIP_DOWNLOAD</key>
    <string>1</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/mac/Documents/projects/appium-mcp-matrix</string>

  <!-- 开机自启 + 崩溃自动拉起（守护核心） -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- launchd 自身的 stdout/stderr（结构化日志另在 logs/webhook.log） -->
  <key>StandardOutPath</key>
  <string>/Users/mac/Documents/projects/appium-mcp-matrix/logs/launchd.webhook.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mac/Documents/projects/appium-mcp-matrix/logs/launchd.webhook.err.log</string>
</dict>
</plist>
